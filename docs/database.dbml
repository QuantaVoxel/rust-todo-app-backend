// =====================================================
// TODO-APP SCHEMA (NORMALIZED - 3NF)
// =====================================================

// ---------- ENUMS (nilai tetap & kecil) ----------
Enum vote_type_enum {
  up
  down
}

Enum recurrence_frequency_enum {
  daily
  weekly
  monthly
  yearly
}

Enum share_permission_enum {
  view
  comment
  edit
}

Enum connection_status_enum {
  pending
  accepted
  blocked
}

Enum notification_type_enum {
  reminder
  comment
  share
  system
}

// ---------- LOOKUP TABLES ----------
Table Task_Statuses {
  status_id int [pk, increment]
  name varchar(50) [unique, not null]   // todo, in_progress, done, ...
}

Table Task_Priorities {
  priority_id int [pk, increment]
  name varchar(50) [unique, not null]   // low, medium, high, ...
  rank_order int [not null, unique]     // untuk sorting
}

Table External_Apps {
  app_id int [pk, increment]
  name varchar(255) [unique, not null]
}

// ---------- USERS ----------
Table Users {
  user_id int [pk, increment]
  username varchar(255) [unique, not null]
  email varchar(255) [unique, not null]
  password_hash varchar(255) [not null]
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]
}

Table Profiles {
  profile_id int [pk, increment]
  user_id int [unique, not null, ref: - Users.user_id]   // 1:1 dengan Users
  first_name varchar(255)
  last_name varchar(255)
  avatar_url varchar(255)
  phone_number varchar(20)
}

Table User_Settings {
  setting_id int [pk, increment]
  user_id int [not null, ref: > Users.user_id]
  setting_key varchar(255) [not null]
  setting_value varchar(255)

  indexes {
    (user_id, setting_key) [unique]
  }
}

Table User_Connections {
  connection_id int [pk, increment]
  user_id_1 int [not null, ref: > Users.user_id]
  user_id_2 int [not null, ref: > Users.user_id]
  status connection_status_enum [not null, default: 'pending']
  created_at datetime [not null, default: `now()`]

  indexes {
    (user_id_1, user_id_2) [unique]
  }
  Note: 'Simpan pasangan terurut (user_id_1 < user_id_2) agar tidak ada duplikat A-B dan B-A'
}

Table User_Notifications {
  notification_id int [pk, increment]
  user_id int [not null, ref: > Users.user_id]
  message text [not null]
  notification_type notification_type_enum [not null]
  is_read boolean [not null, default: false]
  created_at datetime [not null, default: `now()`]

  indexes {
    (user_id, is_read)
  }
}

// Gabungan User_Activity + Activity_Logs (keduanya redundan)
Table Activity_Logs {
  log_id int [pk, increment]
  user_id int [not null, ref: > Users.user_id]
  action varchar(255) [not null]
  entity_type varchar(255)   // polymorphic, tidak bisa di-FK
  entity_id int
  timestamp datetime [not null, default: `now()`]

  indexes {
    (user_id, timestamp)
    (entity_type, entity_id)
  }
}

// ---------- TASKS ----------
Table Tasks {
  task_id int [pk, increment]
  user_id int [not null, ref: > Users.user_id]            // owner
  title varchar(255) [not null]
  description text
  status_id int [not null, ref: > Task_Statuses.status_id]
  priority_id int [ref: > Task_Priorities.priority_id]
  progress_percentage int [not null, default: 0]          // CHECK 0..100
  due_date datetime
  archived_at datetime                                    // NULL = aktif (pengganti Archived_Tasks)
  created_at datetime [not null, default: `now()`]
  updated_at datetime [not null, default: `now()`]

  indexes {
    user_id
    status_id
    due_date
  }
}

Table Subtasks {
  subtask_id int [pk, increment]
  task_id int [not null, ref: > Tasks.task_id]
  title varchar(255) [not null]
  status_id int [not null, ref: > Task_Statuses.status_id]
  created_at datetime [not null, default: `now()`]
}

Table Notes {
  note_id int [pk, increment]
  task_id int [not null, ref: > Tasks.task_id]
  content text [not null]
  created_at datetime [not null, default: `now()`]
}

Table Task_Comments {
  comment_id int [pk, increment]
  task_id int [not null, ref: > Tasks.task_id]
  user_id int [not null, ref: > Users.user_id]
  comment text [not null]
  created_at datetime [not null, default: `now()`]
}

Table Task_Attachments {
  attachment_id int [pk, increment]
  task_id int [not null, ref: > Tasks.task_id]
  file_url varchar(255) [not null]
  file_type varchar(50)
  uploaded_at datetime [not null, default: `now()`]
}

Table Reminders {
  reminder_id int [pk, increment]
  task_id int [not null, ref: > Tasks.task_id]
  reminder_time datetime [not null]
  notification_sent boolean [not null, default: false]
}

Table Recurring_Tasks {
  recurring_id int [pk, increment]
  task_id int [unique, not null, ref: - Tasks.task_id]    // 1 aturan per task
  frequency recurrence_frequency_enum [not null]
  next_due_date datetime [not null]
}

// ---------- LOCATION ----------
Table Locations {
  location_id int [pk, increment]
  location_name varchar(255) [not null]
  latitude float [not null]
  longitude float [not null]

  indexes {
    (latitude, longitude) [unique]
  }
}

Table Task_Location {
  task_id int [not null, ref: > Tasks.task_id]
  location_id int [not null, ref: > Locations.location_id]

  indexes {
    (task_id, location_id) [pk]
  }
}

// ---------- EXTERNAL INTEGRATION ----------
Table Task_External_Integration {
  integration_id int [pk, increment]
  task_id int [not null, ref: > Tasks.task_id]
  app_id int [not null, ref: > External_Apps.app_id]
  external_app_task_id varchar(255) [not null]

  indexes {
    (app_id, external_app_task_id) [unique]
  }
}

// ---------- SHARING & VOTING ----------
Table Task_Sharing {
  task_id int [not null, ref: > Tasks.task_id]
  user_id int [not null, ref: > Users.user_id]
  permission share_permission_enum [not null, default: 'view']

  indexes {
    (task_id, user_id) [pk]
  }
}

Table Task_Votes {
  vote_id int [pk, increment]
  task_id int [not null, ref: > Tasks.task_id]
  user_id int [not null, ref: > Users.user_id]
  vote_type vote_type_enum [not null]

  indexes {
    (task_id, user_id) [unique]   // 1 user = 1 vote per task
  }
}

// ---------- CLASSIFICATION ----------
// Tags_2 dihapus (duplikat Tags)
Table Tags {
  tag_id int [pk, increment]
  name varchar(255) [unique, not null]
}

Table Task_Tags {
  task_id int [not null, ref: > Tasks.task_id]
  tag_id int [not null, ref: > Tags.tag_id]

  indexes {
    (task_id, tag_id) [pk]
  }
}

Table Task_Categories {
  category_id int [pk, increment]
  name varchar(255) [unique, not null]
  description text
}

Table Task_Category_Assignment {
  task_id int [not null, ref: > Tasks.task_id]
  category_id int [not null, ref: > Task_Categories.category_id]

  indexes {
    (task_id, category_id) [pk]
  }
}

Table Task_Labels {
  label_id int [pk, increment]
  name varchar(255) [unique, not null]
}

Table Task_Label_Assignment {
  task_id int [not null, ref: > Tasks.task_id]
  label_id int [not null, ref: > Task_Labels.label_id]

  indexes {
    (task_id, label_id) [pk]
  }
}

// ---------- HISTORY / AUDIT ----------
Table Task_History {
  history_id int [pk, increment]
  task_id int [not null, ref: > Tasks.task_id]
  old_status_id int [ref: > Task_Statuses.status_id]
  new_status_id int [not null, ref: > Task_Statuses.status_id]
  changed_at datetime [not null, default: `now()`]
}

Table Task_Priority_History {
  history_id int [pk, increment]
  task_id int [not null, ref: > Tasks.task_id]
  old_priority_id int [ref: > Task_Priorities.priority_id]
  new_priority_id int [ref: > Task_Priorities.priority_id]
  changed_at datetime [not null, default: `now()`]
}

Table Task_Labels_History {
  history_id int [pk, increment]
  task_id int [not null, ref: > Tasks.task_id]
  old_label_id int [ref: > Task_Labels.label_id]
  new_label_id int [ref: > Task_Labels.label_id]
  changed_at datetime [not null, default: `now()`]
}

Table Task_Notes_History {
  history_id int [pk, increment]
  note_id int [not null, ref: > Notes.note_id]
  old_content text
  new_content text [not null]
  updated_at datetime [not null, default: `now()`]
}
